// Sets hold unique values (duplicates are dropped)
frontend = Set(["HTML", "CSS", "JavaScript"])
backend = Set(["Python", "JavaScript", "Mycel"])

// Membership test
print("Mycel" in backend)
print("Rust" in backend)

// Set operations: union, intersection, difference
both = frontend & backend
all_skills = frontend | backend
front_only = frontend - backend

print(f"Both: {both}")
print(f"All skills: {all_skills}")
print(f"Front only: {front_only}")

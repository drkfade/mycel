{
  "name": "mycel-lang",
  "private": true,
  "version": "0.2.0",
  "license": "Apache-2.0 OR MIT",
  "description": "Mycel: a friendly, typed language that compiles to sandboxed JS (packages: ply)",
  "bin": { "mycel": "bin/mycel", "ply": "bin/ply" },

fruits = ["apple", "pear", "plum"]

# Loop over items with index
for i, fruit in fruits {
  print(f"{i + 1}. {fruit}")
}

# Loop over a range of numbers
for n in 1..=3 {
  print(f"Count: {n}")
}

# while loop
var timer = 3
while timer > 0 {
  print(f"T-minus {timer}")
  timer -= 1
}
print("Liftoff!")

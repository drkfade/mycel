var spam_words: {String: Int} = {}
var ham_words: {String: Int} = {}

fn learn(text: String, is_spam: Bool) {
    for word in text.lower().split(" ") {
        if is_spam {
            spam_words[word] = spam_words.getOr(word, 0) + 1
        } else {
            ham_words[word] = ham_words.getOr(word, 0) + 1
        }
    }
}

fn score(text: String) -> Int {
    var total = 0
    for word in text.lower().split(" ") {
        total += spam_words.getOr(word, 0) - ham_words.getOr(word, 0)
    }
    return total
}

let train = [
    ("win free money now", true),
    ("free prize click now", true),
    ("lunch at noon", false),
    ("meeting notes for today", false)
]

let test = [
    ("free money prize", true),
    ("lunch today", false),
    ("click for a free prize", true),
    ("notes from the meeting", false),
    ("win money now", true),
    ("lunch money", true),
    ("a quiet day", false)
]

for (text, is_spam) in train {
    learn(text, is_spam)
}

var correct = 0
for (text, is_spam) in test {
    let guess = score(text) > 0
    if guess == is_spam {
        correct += 1
    } else {
        print("wrong:", text, "| expected spam:", is_spam)
    }
}

let accuracy = correct.toFloat() / test.length.toFloat()
print(f"{correct} of {test.length} correct ({accuracy:.0%})")

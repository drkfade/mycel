# select (from Go): wait on several channels at once and handle whichever is ready first.
import task

async fn worker(name: String, out: task.Channel<String>, ms: Int) {
  await task.sleep(ms)
  out.send(f"{name} done after {ms}ms")
}

async fn main() {
  let fast = task.Channel<String>()
  let slow = task.Channel<String>()
  spawn worker("fast", fast, 5)
  spawn worker("slow", slow, 40)

  # (which channel, its value); the value is nil when that channel was closed
  let (which, msg) = await task.select([fast, slow])
  print(which, msg ?? "closed")

  # with a timeout: nil when nothing arrives in time
  if let (_, m) = await task.select([slow], timeout: 10) { print(m ?? "closed") } else { print("slow is still working") }
  print(await slow.recv() ?? "closed")
}

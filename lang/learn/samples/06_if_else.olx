score = 85

# Classic if / else if / else
if score >= 90 {
  print("Grade: A")
} else if score >= 80 {
  print("Grade: B")
} else {
  print("Keep practicing")
}

# if as an expression (returns a value)
status = if score >= 60 { "passed" } else { "needs review" }
print(f"Status: {status}")

# Python-style inline if
label = "adult" if score >= 18 else "youth"
print(f"Label: {label}")

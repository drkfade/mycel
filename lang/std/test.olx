// Assertions for `test "name" { ... }` blocks. A failed assertion fails the test with both values shown.
pub extern fn assertEq(actual: Any, expected: Any, message: String = "")
pub extern fn assertNe(actual: Any, unexpected: Any, message: String = "")
pub fn assert(condition: Bool, message: String = "assertion failed") { if !condition { panic(message) } }
pub fn assertTrue(condition: Bool, message: String = "expected true") { if !condition { panic(message) } }
pub fn assertFalse(condition: Bool, message: String = "expected false") { if condition { panic(message) } }
pub fn fail(message: String) -> Never { panic(message) }

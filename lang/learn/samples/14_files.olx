import std.fs

file = "data.txt"

// Write text to a file
fs.writeText(file, "Hello from Mycel files!\nLine 2")

// Read text back
match fs.readText(file) {
  .Ok(content) => {
    print("Read successfully:")
    print(content)
  }
  .Err(e) => print(f"Error: {e.message}")
}

// Clean up
fs.remove(file)
print("Cleaned up file.")

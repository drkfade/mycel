struct Student {
  let name: String, scores: [Int]
}

fn average(scores: [Int]) -> Float {
  if scores.isEmpty { return 0.0 }
  var total = 0
  for s in scores { total += s }
  return total / scores.length
}

fn letterGrade(avg: Float) -> String {
  return match avg.toInt() {
    90..=100 => "A"
    80..=89 => "B"
    70..=79 => "C"
    _ => "Keep practicing"
  }
}

students = [
  Student(name: "Ada", scores: [95, 92, 98]),
  Student(name: "Alan", scores: [82, 88, 85]),
  Student(name: "Grace", scores: [78, 84, 80]),
]

print("=== Class Report Card ===")
for student in students {
  avg = average(student.scores)
  grade = letterGrade(avg)
  print(f"{student.name}: avg={avg:.1f} ({grade})")
}

honor_roll = [s.name for s in students if average(s.scores) >= 85.0]
print(f"Honor Roll: {honor_roll}")

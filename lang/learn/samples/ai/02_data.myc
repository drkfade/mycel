let emails = [
    ("Win a free prize now", true),
    ("Lunch at noon?", false),
    ("Free money, click here", true),
    ("Notes from today's meeting", false)
]

var spam_count = 0
for (text, is_spam) in emails {
    if is_spam {
        spam_count += 1
    }
}

print(f"{spam_count} of {emails.length} emails are spam")
print(emails[1])

let counts: {String: Int} = {"spam": spam_count, "not spam": emails.length - spam_count}
print(counts)
print(counts["spam"])

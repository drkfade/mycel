# Classes, interfaces, inheritance, properties, static members.
interface Shape {
  get name: String
  fn area() -> Float
  fn describe() -> String { return f"{self.name} with area {self.area().fixed(2)}" }
}

class Circle: Shape {
  let radius: Float
  init(radius: Float) { self.radius = radius }
  get name: String { return "circle" }
  fn area() -> Float { return 3.14159 * self.radius * self.radius }
}

class Rect: Shape {
  let w: Float, h: Float
  static var created = 0
  init(w: Float, h: Float) { self.w = w; self.h = h; Rect.created += 1 }
  get name: String { return "rect" }
  fn area() -> Float { return self.w * self.h }
}

class Square: Rect {
  init(side: Float) { super.init(w: side, h: side) }
  override get name: String { return "square" }
}

fn main() {
  let shapes: [Shape] = [Circle(radius: 1.5), Rect(w: 2.0, h: 3.0), Square(side: 2.0)]
  for s in shapes { print(s.describe()) }
  print(f"rects created: {Rect.created}")
}
